# ============================================
# GraphGuard Production Environment Configuration
# ============================================
# SECURITY WARNING: Never commit this file with real values!
# Copy to .env.production and set values securely.

# ============================================
# Database Credentials (Use AWS Secrets Manager / HashiCorp Vault)
# ============================================

# PostgreSQL (AWS RDS Aurora recommended)
POSTGRES_HOST=your-rds-instance.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=graphguard_prod
POSTGRES_PASSWORD=CHANGE_ME_USE_32_CHAR_RANDOM_STRING
POSTGRES_DB=graphguard
POSTGRES_SSL_MODE=require

# Neo4j (AWS Neptune or self-hosted cluster)
NEO4J_URI=bolt://your-neo4j-cluster:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_USE_32_CHAR_RANDOM_STRING

# Redis (AWS ElastiCache recommended)
REDIS_HOST=your-elasticache-cluster.region.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IF_AUTH_ENABLED
REDIS_TLS=true

# ============================================
# API Security
# ============================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_GENERATE_SECURE_KEY

# JWT Configuration (if using JWT auth)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Production domains only
CORS_ALLOW_ORIGINS=https://graphguard.yourdomain.com,https://dashboard.yourdomain.com

# ============================================
# Kafka / Event Streaming (AWS MSK recommended)
# ============================================

KAFKA_BOOTSTRAP_SERVERS=b-1.your-msk-cluster.region.amazonaws.com:9094,b-2.your-msk-cluster.region.amazonaws.com:9094
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=graphguard
KAFKA_SASL_PASSWORD=CHANGE_ME_USE_32_CHAR_RANDOM_STRING
SCHEMA_REGISTRY_URL=https://your-schema-registry:8081

# ============================================
# ML Model Configuration
# ============================================

# Model paths (S3 or local mount)
XGB_MODEL_PATH=s3://graphguard-models/production/xgboost_fraud_v2.json
GAT_MODEL_PATH=s3://graphguard-models/production/gat_fraud_v2.pth

# MLflow tracking (use remote server in prod)
MLFLOW_TRACKING_URI=https://mlflow.yourdomain.com
MLFLOW_S3_ENDPOINT_URL=https://s3.amazonaws.com

# Feature Store
FEAST_REPO_PATH=/app/feast/feature_repo
FEAST_REDIS_HOST=${REDIS_HOST}
FEAST_REDIS_PORT=${REDIS_PORT}

# ============================================
# RAG / LLM
# ============================================

RAG_ENABLED=true
RAG_VECTOR_STORE=pgvector
RAG_PG_DSN=postgresql://graphguard_prod:CHANGE_ME@your-rds-instance.region.rds.amazonaws.com:5432/graphguard
RAG_PG_TABLE=rag_chunks
RAG_DEFAULT_INDEX=graphguard
RAG_EMBEDDINGS_PROVIDER=sentence_transformers
RAG_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_LLM_PROVIDER=groq
RAG_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=CHANGE_ME
RAG_AUTO_INDEX_ON_STARTUP=false
RAG_AUTO_INDEX_ROOT=/app
RAG_AUTO_INDEX_INDEX=graphguard
RAG_AUTO_INDEX_BACKGROUND=true

# ============================================
# Observability
# ============================================

# Sentry Error Tracking
SENTRY_DSN=https://your-key@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus / Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
PROMETHEUS_REMOTE_WRITE_URL=https://prometheus.yourdomain.com/api/v1/write

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Application Settings
# ============================================

# Environment
ENVIRONMENT=production
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# Caching TTLs (seconds)
FEATURE_CACHE_TTL=900
FRAUD_SCORE_CACHE_TTL=900

# ============================================
# External Integrations (Optional)
# ============================================

# Stripe (for payment webhook ingestion)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Plaid (for bank account verification)
PLAID_CLIENT_ID=xxx
PLAID_SECRET=xxx
PLAID_ENV=production

# OFAC Sanctions List API
OFAC_API_KEY=xxx

# ============================================
# Backup Configuration
# ============================================

# S3 Bucket for backups
BACKUP_S3_BUCKET=graphguard-backups-prod
BACKUP_RETENTION_DAYS=30

# ============================================
# AWS Configuration (if using AWS)
# ============================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
# OR use IAM roles (recommended)
# AWS_ROLE_ARN=arn:aws:iam::123456789:role/graphguard-prod
