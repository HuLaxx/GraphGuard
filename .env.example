POSTGRES_PASSWORD=graphguard_dev
NEO4J_AUTH=neo4j/graphguard_dev
GRAFANA_ADMIN_PASSWORD=admin
API_KEY=change-me
CORS_ALLOW_ORIGINS=http://localhost:3000

# RAG / LLM
RAG_ENABLED=true
RAG_VECTOR_STORE=simple
RAG_DEFAULT_INDEX=graphguard
RAG_EMBEDDINGS_PROVIDER=sentence_transformers
RAG_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_LLM_PROVIDER=groq
RAG_LLM_MODEL=llama-3.3-70b-versatile
# Alternative: openai/gpt-oss-120b
GROQ_API_KEY=change-me
# Optional: OpenAI-compatible base for self-hosted models (e.g., vLLM)
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1
# OPENAI_COMPATIBLE_API_KEY=change-me
# Optional: Supabase/pgvector
# RAG_PG_DSN=postgresql://user:pass@host:5432/dbname
RAG_PG_TABLE=rag_chunks

# Auto-index on startup (local only)
RAG_AUTO_INDEX_ON_STARTUP=false
RAG_AUTO_INDEX_ROOT=.
RAG_AUTO_INDEX_INDEX=graphguard
RAG_AUTO_INDEX_BACKGROUND=true
